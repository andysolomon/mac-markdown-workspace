{
  "name": "mac-markdown-workspace",
  "productName": "mac-markdown-workspace",
  "version": "1.0.0",
  "description": "Mac-first local Markdown workspace built with Electron + React",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "ios:build": "vite build --config vite.ios.config.ts",
    "ios:sync": "bun run ios:build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "keywords": [],
  "author": {
    "name": "Andrew Solomon",
    "email": "andrewsolomon.edu@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "41.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "typescript": "5.6.3",
    "vite": "^5.4.21",
    "vitest": "1.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/core": "^7.19.0",
    "@milkdown/ctx": "^7.19.0",
    "@milkdown/plugin-listener": "^7.19.0",
    "@milkdown/preset-commonmark": "^7.19.0",
    "@milkdown/prose": "^7.19.0",
    "@milkdown/react": "^7.19.0",
    "@milkdown/theme-nord": "^7.19.0",
    "@milkdown/transformer": "^7.19.0",
    "@noble/hashes": "^2.2.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@uiw/react-codemirror": "^4.25.8",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "html-to-docx": "^1.8.0",
    "katex": "^0.16.38",
    "mermaid": "^11.13.0",
    "path-browserify": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "packageManager": "bun@1.2.19",
  "overrides": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^24.12.0"
  }
}
